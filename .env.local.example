# Supabase — create a project at https://supabase.com/dashboard
# Project Settings → API: copy URL and anon (public) key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings → API → service_role (server-only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers (server-only — set in Vercel for production)
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# Webhook signature secrets (server-only)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
SHIPPO_API_KEY=your-shippo-api-token
# Shippo does not sign webhooks like Stripe. Protect /api/webhooks/shippo with a
# long random URL token (?token=...). Fail-closed when unset.
# Generate: openssl rand -hex 32
# SHIPPO_WEBHOOK_SECRET=

# Stripe — dedicated TradeFlow account (test keys shown; server-only)
# Dashboard → Developers → API keys: Secret key (sk_test_...)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Dashboard → Developers → Webhooks → your endpoint: Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Platform seller subscription Price id (price_...) — scripts/setup-billing-price.mjs
STRIPE_SUBSCRIPTION_PRICE_ID=price_your-subscription-price-id

# Public app URL (Checkout redirects + pg_cron target)
NEXT_PUBLIC_APP_URL=https://tradeflow-tau-blush.vercel.app

# Shared secret for scheduled cron routes (pg_cron → POST /api/cron/*)
# Generate a long random value; same value must live in Supabase vault as
# cron_shared_secret (see supabase/schedule_payment_chase_cron.sql).
CRON_SHARED_SECRET=generate-a-long-random-string

# WhatsApp Meta/Twilio Content templates outside the 24h service window.
# Keep false until templates are approved and twilio_content_sid values are set.
TEMPLATES_ENABLED=false

# --- Local / verification only — never set in production ---
# TWILIO_DRY_RUN=true              # Skip real Twilio HTTP; return fake SID (never set in production)
# TWILIO_SIMULATE_ERROR=63038      # Throw a fake Twilio error code for retry tests (never set in production)
# FORCE_REAL_SEND=true             # Override reserved +447700900xxx skip locally (never set in production)
# INBOUND_SIMULATE_ERROR=ai_timeout # Force inbound handler failure modes (never set in production)
# ALLOW_TEST_ROUTES=true           # Re-enable /api/internal/test-* on a Vercel deploy (never set in production)
# HEALTH_FORCE_DEGRADED=true       # Force /api/health → 503 for verification (never set in production)

# Sentry (optional — complete no-op until DSN is set)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=               # optional; only needed to upload source maps on build
# SENTRY_ORG=
# SENTRY_PROJECT=
